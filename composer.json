{
  "name": "apie/export",
  "description": "Composer package of the apie library: export",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Pieter Jordaan",
      "email": "pieter_jordaan@hotmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Apie\\Export\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Apie\\Tests\\Export\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.4",
    "apie/core": "self.version",
    "apie/serializer": "self.version",
    "apie/html-builders": "self.version",
    "guzzlehttp/psr7": "^2.13",
    "maennchen/zipstream-php": "^3.2",
    "nyholm/psr7": "^1.8.2",
    "symfony/mime":  "^7.2"
  },
  "extra": {
    "apie-objects": [
    "Apie\\Export\\Lists\\FileExtensionList",
    "Apie\\Export\\ValueObjects\\FileExtension"
]
  },
  "require-dev": {
    "illuminate/support": "*",
    "phpunit/phpunit": "^11.5.2",
    "phpspec/prophecy-phpunit": "^2.5"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}